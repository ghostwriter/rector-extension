{
    "name": "ghostwriter/rector-extension",
    "description": "Rector upgrades rules for Mockery",
    "license": "BSD-3-Clause",
    "type": "rector-extension",
    "keywords": [
        "ghostwriter",
        "mockery",
        "rector",
        "extension",
        "rector-extension"
    ],
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/rector-extension",
    "support": {
        "issues": "https://github.com/ghostwriter/rector-extension/issues",
        "source": "https://github.com/ghostwriter/rector-extension",
        "rss": "https://github.com/ghostwriter/rector-extension/releases.atom",
        "security": "https://github.com/ghostwriter/rector-extension/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "^7.4",
        "mockery/mockery": "^1.6 || ^1.7 || ^2.0",
        "rector/rector": "^2.6 || @dev"
    },
    "conflict": {
        "rector/rector": "<2.6.6"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "phpunit/phpunit": "^9.6.36"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Mockery\\Rector\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\": "tests/Unit/"
        },
        "files": [
            "tests/bootstrap.php"
        ],
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "config": {
        "bump-after-update": false,
        "classmap-authoritative": false,
        "discard-changes": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4.999"
        },
        "platform-check": true,
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "prepend-autoloader": true,
        "process-timeout": 5000,
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "rector": {
            "includes": [
                "config/config.php"
            ]
        },
        "thanks": {
            "name": "ghostwriter/rector-extension",
            "url": "https://github.com/ghostwriter/rector-extension"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "infection": [
            "@xdebug",
            "infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phpunit": [
            "@xdebug",
            "phpunit --colors=always"
        ],
        "test": [
            "@phpunit",
            "@infection"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
